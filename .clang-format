# The style the code was written in. Run it with make docker-format, so
# everyone gets the same clang-format version.
BasedOnStyle: LLVM
IndentWidth: 4
ContinuationIndentWidth: 4
UseTab: Never
ColumnLimit: 100
BreakBeforeBraces: Linux
PointerAlignment: Right
IndentCaseLabels: false
AllowShortCaseLabelsOnASingleLine: true
AllowShortFunctionsOnASingleLine: None
AllowShortEnumsOnASingleLine: true
AlignEscapedNewlines: DontAlign
# The comments are written by hand and some of them are the contract.
ReflowComments: false
# { 0 } and { .fd = fd }, not {0}
Cpp11BracedListStyle: false
SortIncludes: CaseSensitive
# Own header first, then the other project headers, a blank line, and the
# system headers with <linux/...> last. Priority picks the group and
# SortPriority the order inside it. The project headers have priority 0 so
# that the own header stays in their group.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"'
    Priority: 0
    SortPriority: 1
  - Regex: '^<linux/'
    Priority: 2
    SortPriority: 3
  - Regex: '^<'
    Priority: 2
    SortPriority: 2
